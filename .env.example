# Agent Docs for Markdown으로 Source Graph를 만든 Markdown 워크스페이스입니다.
# Windows에서는 Docker Desktop이 읽기 쉬운 슬래시(/) 경로를 권장합니다.
MARKDOWN_MCP_MODE=single
MARKDOWN_MOUNT_SOURCE=C:/Users/you/Documents/my-markdown-workspace

# MCP 검색 결과에 표시할 호스트 경로입니다. 보통 위 경로와 동일합니다.
MARKDOWN_PUBLIC_PATH=C:/Users/you/Documents/my-markdown-workspace

# 워크스페이스별로 컨테이너를 여러 개 실행하면 서로 다른 포트를 사용하세요.
MCP_PORT=8811

